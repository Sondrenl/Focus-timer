# Convex Backend Deployment URL (Automatically populated when you run `npx convex dev`)
VITE_CONVEX_URL=https://your-deployment-name.convex.cloud

# Configure the following on your Convex deployment (`npx convex env set ...`), NOT in Vite:
#   AUTH_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
#   AUTH_GOOGLE_CLIENT_SECRET=your-google-client-secret
#   ALLOWED_REDIRECT_ORIGINS=https://focus-timer.sondrelassen.workers.dev,https://dev-focus-timer.sondrelassen.workers.dev,http://localhost:5173
